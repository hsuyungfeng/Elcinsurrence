# OMC 狀態目錄（工作階段暫存，不需版控）
.omc/

# 嵌入向量快取（可重新產生）
**/.embed_cache/

# 系統與編輯器暫存檔
.DS_Store
Thumbs.db
*~
.~lock.*#

# LibreOffice / MS Office 暫存鎖定檔
~$*

# Python / uv
__pycache__/
*.pyc
.venv/
.env
*.egg-info/

# 執行期資料（可重新產生）
data/db/*
!data/db/.gitkeep
data/rag/*
!data/rag/.gitkeep
data/converted_docx/
# 輸出報告/審核軌跡/申復草稿（含 PHI，P0-3：絕不進版控）
data/output/*
!data/output/.gitkeep
# 匯入暫存檔與案件清單快照（含 PHI）
data/uploads/
logs/

# gsd 工作階段暫存（HANDOFF 會由工具重建，勿再進版控）
.planning/HANDOFF.json

# 真實病患資料（PHI）—— 絕不進版控（D2：病患資料不離開本機）
# 申報 XML／核減清單／病歷文字等含個資的真實樣本
TOTFA.xml
*.xml
!tests/fixtures/**/*.xml
data/samples/
data/phi/
