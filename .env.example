# elc-audit-engine Environment Configuration Example
# Duplicate this file to .env and configure environment variables as needed.

# Path Overrides (defaults resolve relative to PROJECT_ROOT)
# DATA_DIR=
# DB_DIR=
# RAG_DIR=
# OUTPUT_DIR=
# RULE_SOURCE_DIR=

# llama.cpp Server Connection
# LLAMA_CPP_BASE_URL=http://localhost:8080
# LLAMA_CONFIG_PATH=

# Third-party Integrations (DO NOT COMMIT REAL TOKENS/SECRETS)

# 院內網路信任（Phase 32-A）：不需 API 金鑰。
# 存取控制以請求來源位址判定——loopback 與院內網段放行，其餘一律 403。
# 信任網段未設定時自動取伺服器所在介面的 /24 子網；遮罩非 /24 或需信任
# 多個網段時才需明示（逗號分隔 CIDR）：
# ELC_TRUSTED_SUBNETS=192.168.1.0/24,10.0.5.0/24
#
# Host 白名單已移除：私有 IP／localhost／*.local 形式自動放行（防 DNS
# rebinding），換分享器或 DHCP 重發都不必改設定。

# 存取審計日誌（Phase 9-01，選用；預設 data/audit/access.log）
# AUDIT_LOG_PATH=

# LLM 位址僅允許 localhost／loopback／私有網段 IP（判定會送出病歷原文，D2 紅線）。
# 使用內網主機名稱等無法自動判定的位址時，須明示放行（部署者自行確保不出內網）：
# ELC_ALLOW_REMOTE_LLM=1
