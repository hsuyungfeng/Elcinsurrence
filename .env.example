# elc-audit-engine Environment Configuration Example
# Duplicate this file to .env and configure environment variables as needed.

# Path Overrides (defaults resolve relative to PROJECT_ROOT)
# DATA_DIR=
# DB_DIR=
# RAG_DIR=
# OUTPUT_DIR=
# RULE_SOURCE_DIR=

# llama.cpp Server Connection
# LLAMA_CPP_BASE_URL=http://localhost:8080
# LLAMA_CONFIG_PATH=

# Third-party Integrations (DO NOT COMMIT REAL TOKENS/SECRETS)

# API Key 服務間認證（Phase 9-01）
# 格式：caller_id:key，多組以逗號分隔；caller_id 用於審計日誌辨識呼叫方。
# 每組 key 長度須 >= 16 字元；本服務會接觸病歷資料，此變數未設定時
# 服務啟動即失敗（fail-fast），不得以無認證狀態運行。
# 本檔為範例，真實 key 不得進版控（.env 已在 .gitignore）。
# ELC_API_KEYS=his1:CHANGE_ME_至少16字元的隨機字串,his2:CHANGE_ME_另一組隨機字串

# 存取審計日誌（Phase 9-01，選用；預設 data/audit/access.log）
# AUDIT_LOG_PATH=
