# 複製為 ~/.config/elc-audit-engine/env 後修改。
#
# Phase 32-A：院內網路使用**不需驗證**，已無 API 金鑰設定。
# 存取控制改以「請求來源位址」判定：loopback 與院內網段放行，其餘一律 403。
# Host 標頭亦不再需要白名單（私有 IP／localhost／*.local 形式自動放行），
# 換分享器或 DHCP 重發都不必改設定。

# 區域網路部署須設為 0.0.0.0，診間電腦才連得進來。
ELC_SERVER_HOST=0.0.0.0
ELC_SERVER_PORT=5000

# 信任網段（選填）。未設定時自動取伺服器所在介面的 /24 子網。
# 遮罩非 /24、或需同時信任多個網段時才需明示設定（逗號分隔 CIDR）：
# ELC_TRUSTED_SUBNETS=192.168.1.0/24,10.0.5.0/24
#
# ⚠️ 安全邊界就是院內網路：任何連上信任網段的裝置都能讀取病歷。
#    部署前務必確認訪客 Wi-Fi 與診間網段已隔離。

# 正式部署務必關閉 debug
ELC_SERVER_DEBUG=false

# 本機離線 ASR 與 finalize 自動背景管線（Phase 34）
# ELC_ASR_BACKEND=sherpa          # sherpa（預設：SenseVoice int8）或 whisper（重雜訊／台語備援）
# ELC_ASR_DIARIZE=0               # 設為 1 啟用雙人說者分離（num_clusters=2）
# ELC_ASR_THREADS=8
# ELC_CYCLE_AUTO_PIPELINE=1       # finalize 後自動背景執行 ASR → Gemma 4 E4B SOAP 生成（設 0 停用）
