# 複製為 ~/.config/elc-audit-engine/env 後修改（權限請設 600）。
# 格式：caller_id:api_key，多組以逗號分隔。
ELC_API_KEYS=clinic:請改成強隨機金鑰

# 僅本機時維持 127.0.0.1；開放區域網路時改 0.0.0.0 並設定白名單
ELC_SERVER_HOST=127.0.0.1
ELC_SERVER_PORT=5000
# Host 標頭白名單（逗號分隔）。區域網路部署時填入伺服器的 IP 或主機名稱
ELC_ALLOWED_HOSTS=127.0.0.1,localhost

# 正式部署務必關閉 debug
ELC_SERVER_DEBUG=false
